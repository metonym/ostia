{
  "name": "ostia",
  "version": "0.2.9",
  "description": "Fast profiling and benchmarking for Bun.",
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "ostia": "src/cli/main.ts"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "smoke:package": "bun scripts/smoke-package.ts",
    "test": "bun test",
    "typecheck": "tsc6",
    "typecheck:package": "tsc6 -p tests/types",
    "lint": "biome check .",
    "lint:fix": "biome check --write . --unsafe",
    "lint:changed": "biome check --changed --no-errors-on-unmatched .",
    "lint:fix:changed": "biome check --write --unsafe --changed --no-errors-on-unmatched .",
    "knip": "knip-bun",
    "bench": "bun src/cli/main.ts bench bench/*.ts",
    "bench:baseline": "bun src/cli/main.ts bench bench/*.ts --budget 3000 --min-samples 30 --export-json .ostia/baselines/bench-main.json",
    "baseline": "bun src/cli/main.ts baseline save",
    "dogfood": "bun test && bun src/cli/main.ts ci",
    "examples": "bun scripts/run-examples.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "^1.4.2",
    "knip": "^6.38.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metonym/ostia.git"
  }
}
